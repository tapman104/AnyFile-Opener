<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected / Auto-detected state: purple outline and purple-tinted surface -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/tile_selected_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/tile_selected_border" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/surface_container_highest" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/outline_variant" />
        </shape>
    </item>

    <!-- Normal unselected state: surface #211F26 with subtle border -->
    <item>
        <shape>
            <solid android:color="@color/tile_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/outline_variant" />
        </shape>
    </item>

</selector>

